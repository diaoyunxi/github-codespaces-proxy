{
  "name": "http-over-wss-proxy",
  "version": "1.0.0",
  "private": true,
  "description": "HTTP CONNECT proxy over WebSocket Secure tunnel (tcp-over-wss), no TUN, no driver",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "server": "node server/index.js",
    "client": "node client/index.js",
    "test": "node --test 'test/*.test.js'",
    "test:unit": "node --test 'test/protocol.test.js' 'test/ssrf.test.js' 'test/session.test.js' 'test/tunnel.test.js'",
    "test:e2e": "node --test 'test/e2e.test.js' 'test/tls.test.js'"
  },
  "dependencies": {
    "ws": "^8.21.3"
  }
}
